# Use a folder on an external HDD, not the same disk as the server.
# Example: /Volumes/BackupSSD/bn-trip
BNTRIP_BACKUP_DIR=/Volumes/CHANGE_ME/bn-trip

# Optional: an rclone crypt remote backed by Cloudflare R2.
# Keep the trailing path dedicated to this app.
# Example: bntrip-crypt:bn-trip-backups
BNTRIP_RCLONE_REMOTE=
