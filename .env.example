POSTGRES_PASSWORD=change-me-for-production
DATABASE_URL=postgresql://bntrip:change-me-for-production@localhost:5434/bntrip
AUTH_SECRET=generate-a-long-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=https://trip.basnana.com
GOOGLE_REDIRECT_URI=https://trip.basnana.com/api/auth/google/callback
GOOGLE_OWNER_EMAIL=sarayutkongpeng@gmail.com
STORAGE_BACKEND=local
STORAGE_ADMIN_EMAIL=sarayutkongpeng@gmail.com
VERCEL_STATIC_LIMIT_BYTES=104857600
NEON_STORAGE_LIMIT_BYTES=536870912
BLOB_STORAGE_LIMIT_BYTES=1000000000
# Optional: enables live flight status, gate and terminal updates.
FLIGHTAWARE_API_KEY=
# Optional: enables project-level Neon storage metrics instead of the SQL fallback
# NEON_PROJECT_ID=project-id
# NEON_API_KEY=neon-api-key
UPLOAD_DIR=/app/uploads
DATABASE_POOL_MAX=10
CLOUDFLARE_TUNNEL_TOKEN=paste-your-cloudflare-tunnel-token-here

